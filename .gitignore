# Rust build artifacts
/target/
**/target/

# Compiled Zymbol bytecode cache
*.zyc

# Cargo lock for libraries (keep for binaries)
# Cargo.lock is intentionally committed for the workspace binary

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test output
tests/output/
*.tmp

# Scratch files the std/io and std/db tests create in the working directory.
# They used to be written to /tmp, which does not exist on Windows; the tests now
# use relative paths, so the artifacts land wherever the suite was run from.
zy_io_*
zy_test_db_*.db

# Standalone executables built by `zymbol build`
*.exe
*.out

# Environment / secrets
.env
.env.*

# Packaging — built artifacts and release notes (uploaded to GitHub Releases, not committed)
packaging/dist/
packaging/RELEASE_NOTES_*.md

# Manual test logs (generated per session, not committed)
tests/manual/logs/manual_*.log
