// Test: std/db basic roundtrip over SQLite/ODBC.
// Proves parameter binding (G4 gone: value contains a single quote) and that
// rows come back as NamedTuples keyed by column name. Requires the SQLite ODBC
// driver registered in the system (Driver={SQLite3}).
<# std/db => db

ruta = "Driver={SQLite3};Database=/tmp/zy_test_db_basic.db;"
db::connect("c", ruta)
db::exec("c", "DROP TABLE IF EXISTS socios1")
db::exec("c", "CREATE TABLE socios1(cod INTEGER PRIMARY KEY, nombre TEXT)")
db::exec("c", "INSERT INTO socios1(cod, nombre) VALUES(?, ?)", (1, "O'Brien & Co."))
db::exec("c", "INSERT INTO socios1(cod, nombre) VALUES(?, ?)", (2, "Acme"))

>> db::query_value("c", "SELECT COUNT(*) FROM socios1") ¶

fila = db::query_one("c", "SELECT cod, nombre FROM socios1 WHERE cod = ?", (1,))
>> fila.cod ¶
>> fila.nombre ¶

>> db::table_exists("c", "socios1") ¶
>> db::table_exists("c", "no_existe") ¶

db::disconnect("c")
