// Test: std/io write/read/append/exists/delete roundtrip + soft error
<# std/io => io

// Relative, not /tmp: Windows has no /tmp, so an absolute POSIX path made this
// test unrunnable there rather than failing for a reason about std/io.
tmp = "zy_io_rw_test.txt"

// write -> read roundtrip
io::write(tmp, "hello")
>> io::read(tmp) ¶
>> io::exists(tmp) ¶

// append, then read concatenated
io::append(tmp, " world")
>> io::read(tmp) ¶

// delete -> no longer exists
io::delete(tmp)
>> io::exists(tmp) ¶

// reading a missing file returns a soft IO error (catchable), not a crash
>> io::read("zy_io_absent_zzz.txt") ¶
