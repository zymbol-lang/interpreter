// Test: std/io mkdir/list/delete on directories
<# std/io => io

// Relative, not /tmp — see stdlib_io_rw.zy.
dir = "zy_io_dir_test"

// start clean (ignore error if it does not exist yet)
io::delete(dir)

// mkdir creates parent directories
io::mkdir(dir)
>> io::exists(dir) ¶

// populate and count entries (list order is OS-dependent, so check length only)
io::write("zy_io_dir_test/a.txt", "1")
io::write("zy_io_dir_test/b.txt", "2")
>> io::list(dir)$# ¶

// delete the directory recursively
io::delete(dir)
>> io::exists(dir) ¶
