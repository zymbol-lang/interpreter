// manual_check.zy — Interactive manual test runner written in Zymbol
// Usage: zymbol run tests/scripts/manual_check.zy
// Run from interpreter/ directory.
// Runs each test in tests/manual/, asks PASS/FAIL/SKIP,
// and records every result to a timestamped log file.

// ─── Configuration ───────────────────────────────────────────────────────────
ZYMBOL := "./target/release/zymbol"
MANUAL := "./tests/manual"
LOGS   := "./tests/manual/logs"
SEP    := "═══════════════════════════════════════════════════════════"
SUB    := "───────────────────────────────────────────────────────────"

// ─── Helper: append one line to the log ──────────────────────────────────────
// (single-quote-free text only — sufficient for paths, PASS/FAIL, timestamps)
wlog(file, line) {
    <\ "printf '%s\\n' '" line "' >> " file \>
}

// ─── Setup ───────────────────────────────────────────────────────────────────
<\ "mkdir -p " LOGS \>

ts       = <\ "date '+%Y%m%d_%H%M%S'" \>
log_file = LOGS $++ "/manual_" $++ ts $++ ".log"

// ─── Print test plan from manual.zy ──────────────────────────────────────────
plan = <\ ZYMBOL " run " MANUAL "/manual.zy 2>&1" \>
>> plan ¶
>> "Log: " log_file ¶
>> "" ¶
>> "Press ENTER to start, or Ctrl-C to cancel." ¶
<< _enter

// ─── Write log header ────────────────────────────────────────────────────────
date_str = <\ "date '+%Y-%m-%d %H:%M:%S'" \>

<\ "printf '%s\\n' '" SEP "' > " log_file \>
wlog(log_file, "  Zymbol Manual Test Log")
wlog(log_file, "  Date : " $++ date_str)
wlog(log_file, "  Log  : " $++ log_file)
wlog(log_file, SEP)
wlog(log_file, "")

// ─── Collect test files ───────────────────────────────────────────────────────
files_raw = <\ "find " MANUAL " -name '*.zy' ! -name 'manual.zy' | sort" \>
all_parts = files_raw $/ "\n"
files     = all_parts$| (f -> f$# > 0)
total     = files$#

? (total == 0) {
    >> "No test files found in " MANUAL ¶
    <~
}

pass    = 0
fail    = 0
skipped = 0

>> SEP ¶
>> "  Running " total " test(s)" ¶
>> SEP ¶

// ─── Run each test ────────────────────────────────────────────────────────────
@ test_file:files {
    >> "" ¶
    >> SUB ¶
    >> "  TEST: " test_file ¶
    >> SUB ¶

    // Show description from the file's leading comment block
    description = <\ "grep '^//' " test_file " | head -5 | sed 's|^//||' | sed 's|^ ||'" \>
    >> description ¶
    >> "" ¶

    // Run on the real TTY — stdout/stderr go directly to terminal.
    // BashExec captures nothing here; the user sees and interacts with the program.
    >> "  [ running — observe terminal output below ]" ¶
    >> "" ¶
    <\ "bash -c 'timeout 30 " ZYMBOL " run " test_file " </dev/tty >/dev/tty 2>/dev/tty || true'" \>
    >> "" ¶

    // ── Ask for result ────────────────────────────────────────────────────────
    >> SUB ¶
    >> "  Result?  [p = PASS   f = FAIL   s = SKIP]  (default: p)  > " ¶
    << answer

    >> "  Note (Enter to skip)  > " ¶
    << note

    result = "PASS"
    ? (answer == "f" || answer == "fail") {
        result  = "FAIL"
        fail   += 1
    } _? (answer == "s" || answer == "skip") {
        result   = "SKIP"
        skipped += 1
    } _ {
        pass += 1
    }

    >> "  → " result ¶

    // ── Append result to log ──────────────────────────────────────────────────
    t = <\ "date '+%H:%M:%S'" \>
    wlog(log_file, SUB)
    wlog(log_file, "  File   : " $++ test_file)
    wlog(log_file, "  Result : " $++ result)
    ? (note$# > 0) { wlog(log_file, "  Note   : " $++ note) }
    wlog(log_file, "  Time   : " $++ t)
    wlog(log_file, "")
}

// ─── Summary ─────────────────────────────────────────────────────────────────
>> "" ¶
>> SEP ¶
>> "  SUMMARY" ¶
>> SEP ¶
>> "  Total  : " total ¶
>> "  PASS   : " pass ¶
>> "  FAIL   : " fail ¶
>> "  SKIP   : " skipped ¶
>> "" ¶
>> "  Log: " log_file ¶
>> SEP ¶

wlog(log_file, SEP)
wlog(log_file, "  SUMMARY")
wlog(log_file, "  Total  : " $++ total)
wlog(log_file, "  PASS   : " $++ pass)
wlog(log_file, "  FAIL   : " $++ fail)
wlog(log_file, "  SKIP   : " $++ skipped)
wlog(log_file, SEP)
