// Test: || alternatives in match patterns — chars and strings
keys = ['p', 'P', 'q', 'Q', 'z']
@ k:keys {
    action = ?? k {
        'p' || 'P' => "pause"
        'q' || 'Q' => "quit"
        _          => "other"
    }
    >> k ": " action ¶
}

words = ["yes", "YES", "no", "NO", "maybe"]
@ w:words {
    answer = ?? w {
        "yes" || "YES" => "affirmative"
        "no"  || "NO"  => "negative"
        _              => "unknown"
    }
    >> w " -> " answer ¶
}

// Three or more alternatives
d = 6
kind = ?? d {
    1 || 3 || 5 || 7 => "odd"
    2 || 4 || 6 || 8 => "even"
    _                => "out of range"
}
>> kind ¶

// A single pattern per arm keeps working unchanged
n = 3
label = ?? n {
    1 => "one"
    3 => "three"
    _ => "other"
}
>> label ¶
