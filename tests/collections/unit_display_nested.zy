// Unit display unification (2026-06-12): standalone Unit prints as nothing in
// both engines, but Unit NESTED in a collection renders as `()` — previously
// the tree-walker printed an empty hole ([1, , 3]) while the VM printed `()`.

<# std/json => j

f() { <~ }
u = f()

// Standalone: prints nothing (both engines, unchanged)
>> u ¶
>> "x" u "y" ¶

// Nested: visible as ()
t = (1, u, 3)
>> t ¶
nt = (a: u, b: 2)
>> nt ¶

// JSON null decodes to Unit inside an array
datos = j::decode("[1, null, 3]")
>> datos ¶

// Nested object with null field
obj = j::decode("\{\"x\": null, \"y\": 5}")
>> obj ¶
