// BUG-005 regression (resuelto v0.0.5): VM tuple equality (==, <>) always returned #0.
//
// Root cause: cmp_direct() and Value::equals() had no Tuple arm — fell through to
// `_ => 1` (not-equal) regardless of actual content.
//
// Discovered during Serpiente --vm testing: food detection
//   `cab == comida || cab == (fr_com, fc_com + 1)`
// always evaluated to #0, so comio=#0, puntos stayed at 0,
// and no second fruit was ever spawned.
//
// Fix: recursive element-wise comparison added to both cmp_direct() and
// Value::equals() in crates/zymbol-vm/src/lib.rs.

// 1. Literal tuple equality
a = (1, 2)
b = (1, 2)
c = (1, 3)
>> (a == b) ¶
>> (a == c) ¶

// 2. Variable-based construction
x = 1
y = 2
d = (x, y)
>> (d == a) ¶

// 3. Arithmetic inside tuple literal
fc = 1
>> ((fc + 0, fc + 1) == (1, 2)) ¶

// 4. Inequality operator
>> (a <> c) ¶
>> (a <> b) ¶

// 5. Exact Serpiente food-collision pattern
fr_com = 15
fc_com = 19
cab    = (15, 20)
comida = (15, 19)
? cab == comida || cab == (fr_com, fc_com + 1) {
    >> "comio" ¶
} _ {
    >> "no comio" ¶
}

// 6. Tuple comparison in conditional without ||
pos1 = (3, 7)
pos2 = (3, 7)
pos3 = (3, 8)
? pos1 == pos2 { >> "iguales" ¶ }
? pos1 == pos3 { >> "error" ¶ }
? pos1 <> pos3 { >> "distintos" ¶ }

// 7. Nested tuple (tuple of tuples)
t1 = ((1, 2), (3, 4))
t2 = ((1, 2), (3, 4))
t3 = ((1, 2), (3, 5))
>> (t1 == t2) ¶
>> (t1 == t3) ¶
