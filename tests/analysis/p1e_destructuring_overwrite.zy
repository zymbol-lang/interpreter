// P1-E: Destructuring overwrites existing variables in scope

// Mutable variable is overwritten
a = 10
b = 20
[a, b] = [99, 88]
>> a ¶
>> b ¶

// _ position is skipped (left intact)
x = 42
[x, _] = [77, 999]
>> x ¶

// L14 (fixed): destructuring into a `:=` constant is now a semantic error —
// covered by tests/errors/semantic/const_destructure_overwrite.zy.
// Destructuring into regular variables (above) remains the supported path.
limit := 100
[nuevo, extra] = [200, 300]
>> limit ¶
>> nuevo ¶
>> extra ¶
