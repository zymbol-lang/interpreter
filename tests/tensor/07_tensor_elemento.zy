// Test: acceso a elementos por lista de indices
<# ./tensor => t

m = [[10.0, 20.0, 30.0], [40.0, 50.0, 60.0]]

// elemento(m, [fila, col]) — 1-based
>> t::elemento(m, [1, 1]) ¶
>> t::elemento(m, [1, 2]) ¶
>> t::elemento(m, [1, 3]) ¶
>> t::elemento(m, [2, 1]) ¶
>> t::elemento(m, [2, 3]) ¶

// vector 1D
v = [5.0, 10.0, 15.0]
>> t::elemento(v, [2]) ¶
