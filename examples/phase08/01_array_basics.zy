// Phase 8: Basic array operations
// Arrays are collections of values

>> "=== Array Basics ===" ¶

// Empty array
vacio = []
>> "Empty array: " vacio ¶

// Array with integers
numeros = [1, 2, 3, 4, 5]
>> "Numbers: " numeros ¶

// Array with strings
nombres = ["Alice", "Bob", "Charlie"]
>> "Names: " nombres ¶

// Arrays are homogeneous; use a tuple to hold mixed-type values
mezclado = (1, "hello", #1, 42)
>> "Mixed (tuple): " mezclado ¶

¶
>> "=== Array Indexing ===" ¶

// Access elements by index (1-based)
primero = numeros[1]
>> "First number: " primero ¶

segundo = numeros[2]
>> "Second number: " segundo ¶

ultimo = numeros[5]
>> "Last number: " ultimo ¶

// String arrays
nombre = nombres[2]
>> "Second name: " nombre ¶

¶
>> "=== Array in Variables ===" ¶

// Store in variable and access
frutas = ["apple", "banana", "orange"]
>> "Fruits: " frutas ¶
>> "First fruit: " frutas[1] ¶
>> "Second fruit: " frutas[2] ¶
>> "Third fruit: " frutas[3] ¶
