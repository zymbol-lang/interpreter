// Phase 8: Nested arrays (matrices)
// Arrays can contain other arrays

>> "=== 2D Arrays (Matrices) ===" ¶

// Matrix 3x3
matriz = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
>> "Matrix: " matriz ¶

// Access rows (1-based)
fila1 = matriz[1]
>> "First row: " fila1 ¶

fila2 = matriz[2]
>> "Second row: " fila2 ¶

¶
>> "=== Access Individual Elements ===" ¶

// Chained indexing for matrix elements (1-based)
elemento11 = matriz[1][1]
>> "Element [1][1]: " elemento11 ¶

elemento23 = matriz[2][3]
>> "Element [2][3]: " elemento23 ¶

elemento33 = matriz[3][3]
>> "Element [3][3]: " elemento33 ¶

¶
>> "=== Iterate over Matrix ===" ¶

>> "Matrix elements:" ¶
@ fila:matriz {
    @ elem:fila {
        >> elem " "
    }
    ¶
}

¶
>> "=== Table Data ===" ¶

// Represent table rows as tuples (mixed String + Int)
personas = [("Alice", 25), ("Bob", 30), ("Charlie", 35)]

>> "People table:" ¶
@ persona:personas {
    nombre = persona[1]
    edad = persona[2]
    >> "  " nombre " - " edad " years old" ¶
}
