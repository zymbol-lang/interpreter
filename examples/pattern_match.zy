// Pattern matching example with grade calculation

// Grade a student based on score (range patterns return a Char)
grade(score) {
    <~ ?? score {
        90..100 => 'A'
        80..89  => 'B'
        70..79  => 'C'
        60..69  => 'D'
        _       => 'F'
    }
}

// Test different scores
scores = [95, 87, 72, 65, 45]

>> "Grade Report:" ¶
@ score:scores {
    g = grade(score)
    >> "Score: " score " -> Grade: " g ¶
}

// Day of week example using a list-containment pattern
day = 3
day_type = ?? day {
    [1, 7] => "Weekend"
    2..6   => "Weekday"
    _      => "Invalid day"
}

>> ¶
>> "Day " day " is: " day_type ¶

// FizzBuzz: arbitrary boolean guards are not match patterns,
// so use ? / _? / _ instead
>> ¶
>> "FizzBuzz (1-15):" ¶
@ n:1..15 {
    ? n % 15 == 0 {
        >> "FizzBuzz "
    } _? n % 3 == 0 {
        >> "Fizz "
    } _? n % 5 == 0 {
        >> "Buzz "
    } _ {
        >> n " "
    }
}
>> ¶
