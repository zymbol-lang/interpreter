// Phase 11: Classification — comparison patterns vs. conditional guards
// Zymbol's match (??) supports comparison patterns `< expr` for threshold
// classification. Arbitrary boolean guards (e.g. modulo tests) are not match
// patterns — use ? / _? / _ for those.

>> "=== Comparison Patterns (< expr) ===" ¶

// Threshold classification with comparison patterns (first match wins)
score = 95
performance = ?? score {
    < 60 => "Fail"
    < 70 => "Pass"
    < 80 => "Fair"
    < 90 => "Good"
    _    => "Excellent"
}
>> "Score " score " performance: " performance ¶

num = 15
classification = ?? num {
    < 1  => "Zero or negative"
    < 11 => "Low but positive"
    _    => "High"
}
>> "Number " num " is: " classification ¶

¶
>> "=== Range and List Patterns ===" ¶

// Range patterns for bounded categories
value = 25
category = ?? value {
    0..50   => "Low range"
    51..100 => "High range"
    _       => "Out of range"
}
>> "Value " value " category: " category ¶

¶
>> "=== Conditional Guards (? / _?) ===" ¶

// Modulo tests are not match patterns — use if/else-if instead
number = 10
? number % 2 == 0 {
    >> "Number " number " is: Even number" ¶
} _ {
    >> "Number " number " is: Odd number" ¶
}
