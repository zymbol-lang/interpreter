// ===== BASE CONVERSION EXPRESSIONS DEMONSTRATION =====
// The base operators 0b|x| 0o|x| 0d|x| 0x|x| take a number or char and
// return its TEXT representation in that base (a String). For example
// 0x|65| → "0x0041". They are one-directional: value → base-string.

>> "=== 1. CHAR → BASE STRINGS (character codes) ===" ¶
letra = 'A'
>> "Character: " letra ¶
>> "  Binary:      " 0b|letra| ¶
>> "  Octal:       " 0o|letra| ¶
>> "  Decimal:     " 0d|letra| ¶
>> "  Hexadecimal: " 0x|letra| ¶
¶

// Unicode emoji
emoji = '😀'
>> "Emoji: " emoji ¶
>> "  Unicode (hex): " 0x|emoji| ¶
>> "  Unicode (dec): " 0d|emoji| ¶
¶

>> "=== 2. INT → BASE STRINGS ===" ¶
codigo_A = 65
>> "Number " codigo_A " in each base:" ¶
>> "  Binary:      " 0b|codigo_A| ¶
>> "  Octal:       " 0o|codigo_A| ¶
>> "  Decimal:     " 0d|codigo_A| ¶
>> "  Hexadecimal: " 0x|codigo_A| ¶
¶

codigo_emoji = 128512
>> "Number " codigo_emoji " (hex): " 0x|codigo_emoji| ¶
¶

>> "=== 3. ASCII TABLE GENERATOR ===" ¶
>> "First 10 printable ASCII codes in multiple bases:" ¶
@ i:65..74 {
    >> "  Code " i ": [Bin: " 0b|i| ", Oct: " 0o|i| ", Hex: " 0x|i| "]" ¶
}
¶

>> "=== 4. TEACHING NUMERIC SYSTEMS ===" ¶
ch = 'Z'
>> "The character 'Z' in different bases:" ¶
>> "  Binary (base 2):   " 0b|ch| ¶
>> "  Octal (base 8):    " 0o|ch| ¶
>> "  Decimal (base 10): " 0d|ch| ¶
>> "  Hex (base 16):     " 0x|ch| ¶
¶

>> "=== ALL TESTS PASSED! ===" ¶
