// Comprehensive String Operations Guide for Zymbol
// Shows the native string operators (1-based indexing throughout)

>> "========================================" ¶
>> "  STRING OPERATIONS - COMPREHENSIVE" ¶
>> "========================================" ¶
¶

// ===== 1. LENGTH ($#) =====
>> "--- 1. Length ($#) ---" ¶
texto = "holamundo"
>> "Length of 'holamundo': " (texto$#) ¶
¶

// ===== 2. SLICING ($[a..b], 1-based inclusive) =====
>> "--- 2. Slicing ($[a..b]) ---" ¶
>> "First 4 [1..4]: " texto$[1..4] ¶
>> "Last 4  [6..]:  " texto$[6..] ¶
>> "Middle  [3..7]: " texto$[3..7] ¶
¶

// ===== 3. CONCATENATION (juxtaposition / $++) =====
>> "--- 3. Concatenation ---" ¶
saludo = "Hola" $++ " " $++ "Mundo"
>> saludo ¶
con_char = saludo $++ "!"
>> con_char ¶
¶

// ===== 4. SPLIT ($/) =====
>> "--- 4. Split ($/) ---" ¶
frutas = "apple,banana,orange" $/ ","
>> "Split by comma: " frutas ¶
>> "First fruit: " frutas[1] ¶
¶

// ===== 5. CONTAINS ($?) =====
>> "--- 5. Contains ($?) ---" ¶
>> "Contains 'mun': " (texto$? "mun") ¶
>> "Contains 'xyz': " (texto$? "xyz") ¶
¶

// ===== 6. REPLACE ($~~[old:new]) =====
>> "--- 6. Replace ($~~) ---" ¶
>> "Replace 'o' with '0': " (texto$~~["o":"0"]) ¶
¶

// ===== 7. INDEXING (1-based) =====
>> "--- 7. Character Indexing ---" ¶
>> "First char  [1]: " texto[1] ¶
>> "Fourth char [4]: " texto[4] ¶
>> "Last char  [-1]: " texto[-1] ¶
¶

// ===== 8. STARTS / ENDS WITH (slice + compare) =====
>> "--- 8. Starts / Ends With ---" ¶
>> "Starts with 'hola': " (texto$[1..4] == "hola") ¶
>> "Ends with 'undo':  " (texto$[6..9] == "undo") ¶
¶

// ===== 9. COUNT CHARACTER OCCURRENCES (loop) =====
>> "--- 9. Count Occurrences ---" ¶
target = 'o'
count = 0
@ char:texto {
    ? char == target {
        count++
    }
}
>> "Count of 'o' in 'holamundo': " count ¶
¶

// ===== 10. FILTER (keep only vowels) =====
>> "--- 10. Filter (Keep Only Vowels) ---" ¶
vowels = "aeiou"
resultado = ""
@ char:texto {
    ? vowels$? char {
        resultado = resultado $++ char
    }
}
>> "Original: " texto ¶
>> "Only vowels: " resultado ¶
¶

// ===== 11. REVERSE STRING (loop) =====
>> "--- 11. Reverse String ---" ¶
fuente = "abc"
reversed = ""
@ char:fuente {
    reversed = ("" $++ char) $++ reversed
}
>> "Original: " fuente ¶
>> "Reversed: " reversed ¶
¶

// ===== 12. REPEAT ($*) =====
>> "--- 12. Repeat ($*) ---" ¶
>> "Line: " ("=" $* 20) ¶
>> "Sep:  " ("-" $* 10) ¶
¶

// ===== 13. JOIN ARRAY TO STRING (loop) =====
>> "--- 13. Join Array to String ---" ¶
words = ["Hello", "beautiful", "world"]
joined = ""
count = 0
total = words$#
@ word:words {
    joined = joined $++ word
    count++
    ? count < total {
        joined = joined $++ " "
    }
}
>> "Joined: " joined ¶
¶

>> "========================================" ¶
>> "✓ All string operations demonstrated" ¶
>> "========================================" ¶
